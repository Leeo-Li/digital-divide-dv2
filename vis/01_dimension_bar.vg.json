    "legend": {
      "labelFont": "IBM Plex Sans",
      "titleFont": "IBM Plex Sans",
      "labelFontSize": 12,
      "titleFontSize": 12,
      "symbolSize": 110,
      "orient": "bottom"
    },
    "title": {
