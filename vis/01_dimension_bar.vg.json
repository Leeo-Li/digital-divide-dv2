{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "National digital inclusion dimensions in Australia, 2024",
  "title": {
    "text": "Affordability is the weakest part of digital inclusion",
    "subtitle": "ADII dimension scores, 2024. Higher scores mean stronger digital inclusion."
  },
  "width": "container",
  "height": {
    "step": 54
  },
  "data": {
    "values": [
      {
        "dimension": "Access",
        "score": 76.82,
        "status": "Stronger"
      },
      {
        "dimension": "Digital Ability",
        "score": 73.6,
        "status": "Middle"
      },
      {
        "dimension": "Affordability",
        "score": 70.25,
        "status": "Weakest"
      }
    ]
  },
  "config": {
    "view": {
      "stroke": null
    },
    "axis": {
      "labelFont": "IBM Plex Sans",
      "titleFont": "IBM Plex Sans",
      "labelFontSize": 12,
      "titleFontSize": 13,
      "labelColor": "#17212b",
      "titleColor": "#17212b",
      "gridColor": "#dbe4ee",
      "labelLimit": 320
